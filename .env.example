# Public browser configuration. These values are safe to expose only because
# Supabase RLS is enabled; never put service_role or database passwords here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_APP_VERSION=local

# Server-side public Supabase settings used during SSR.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SITE_URL=https://biotrack.example.com
APP_VERSION=COMMIT_SHA

# Server-only. Put this in Cloudflare/Wrangler secrets or .dev.vars, never in
# a VITE_ variable or committed .env file.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# ALERT_CRON_SECRET=YOUR_ALERT_CRON_SECRET
# OPERATIONS_CRON_SECRET=YOUR_OPERATIONS_CRON_SECRET
